# Sourced by bash-completion after it has loaded.

# Completes an alias as its expansion, e.g. `dc u<Tab>` as `docker compose u<Tab>`.
# Expansions are split on spaces, so aliases containing quotes are not supported.
_alias_completion() {
  local alias=$1 expansion=${BASH_ALIASES[$1]}
  local -a words
  read -ra words <<<"$expansion"
  local cmd=${words[0]} prev=$3

  # bash-completion loads completions lazily, so `complete -p` only knows the
  # command after this.
  _comp_load "$cmd" || return
  # Extract the function name from e.g. `complete -o default -F __start_docker docker`.
  local func
  func=$(complete -p "$cmd" 2>/dev/null | sed -nE 's/.* -F ([^ ]+).*/\1/p')
  [[ $func ]] || return

  # When completing the first argument, the previous word was the alias itself.
  ((COMP_CWORD == 1)) && prev=${words[-1]}
  # Shadow the COMP_* variables so the completion function sees the expanded
  # command line, without touching the originals.
  local COMP_LINE="$expansion${COMP_LINE#"$alias"}"
  local COMP_POINT=$((COMP_POINT + ${#expansion} - ${#alias}))
  local COMP_CWORD=$((COMP_CWORD + ${#words[@]} - 1))
  local -a COMP_WORDS=("${words[@]}" "${COMP_WORDS[@]:1}")

  "$func" "$cmd" "$2" "$prev"
}
complete -o default -F _alias_completion d dc p pc k
